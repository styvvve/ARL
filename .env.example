# Copier en .env puis adapter. Ne jamais versionner .env (il peut contenir une clé d'API).

# Fournisseur du modèle (seul « ollama » est géré pour l'instant)
ARL_FOURNISSEUR=ollama
ARL_MODELE=qwen3:1.7b
ARL_OLLAMA_URL=http://localhost:11434

# Clé d'API : inutile avec Ollama, à remplir seulement pour une API distante
ARL_CLE_API=

# Boucle agentique
ARL_CONSIGNE=v2
ARL_MAX_ETAPES=6
ARL_BUDGET_CONTEXTE=6000

# Dossiers : laisser commentés pour utiliser les valeurs par défaut.
# Un chemin relatif est résolu depuis le dossier où l'on lance `arl`, pas depuis la racine du projet.
# ARL_DOSSIER_NOTES=/chemin/absolu/vers/data/notes
# ARL_TRACES=traces
